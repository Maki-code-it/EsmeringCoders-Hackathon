# ============================================================
# SahodSuri environment template
# Copy this file to ".env" in the repository root. Never commit .env.
# One root .env is read by both Vite (frontend) and Express (backend).
#
# PUBLIC  = bundled into browser code (only VITE_* variables are exposed)
# PRIVATE = backend only. Never prefix with VITE_.
# ============================================================

# Application (PRIVATE, backend)
NODE_ENV=development
PORT=5000

# DEV_USER_ID: PRIVATE, development only. A Supabase auth user id that owns data
# while sign-in is not built. Ignored in production (a signed-in user is required).
DEV_USER_ID=

# Frontend
# FRONTEND_URL: PRIVATE (backend only, used for the CORS allow-list)
FRONTEND_URL=http://localhost:5173
# VITE_API_BASE_URL: PUBLIC (must never contain a secret)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase
# SUPABASE_URL: PRIVATE for backend use (project URL is not secret, but keep paired with keys)
SUPABASE_URL=
# SUPABASE_ANON_KEY: backend copy of the public anon/publishable key
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: PRIVATE. Bypasses Row Level Security. Backend ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (PUBLIC, frontend). Use the project URL and the anon/publishable key ONLY.
# Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Lumen API credentials (PRIVATE, backend only)
# Sent as the HTTP headers "lumen-api-key" and "lumen-api-secret".
LUMEN_API_KEY=
LUMEN_API_SECRET=

# Lumen API endpoints (PRIVATE, backend only)
# Fill in ONLY after reviewing the official OVERCLOCK 2026 Lumen documentation.
LUMEN_OCR_ENDPOINT=
LUMEN_CHAT_ENDPOINT=
# Lumen chat gateway origin and instance id used by the AI assistant.
LUMEN_CHAT_ORIGIN=
LUMEN_INSTANCE_ID=
